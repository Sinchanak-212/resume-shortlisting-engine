# Copy this file to .env and fill in your own keys. NEVER commit .env to git.
# Optional providers:
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides - check each provider's current model list before setting these,
# model names/availability change over time.
# GEMINI_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=

# Optional: custom Tesseract binary path (Windows example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
